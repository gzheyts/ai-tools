<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="2026-04-04-001-create-persons-table"
               author="course-demo">

        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="persons"/>
            </not>
        </preConditions>

        <createTable tableName="persons">
            <column name="id" type="UUID">
                <!-- Oracle: RAW(16) -->
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="first_name" type="VARCHAR(255)">
                <!-- Oracle: VARCHAR2(255) -->
                <constraints nullable="false"/>
            </column>
            <column name="last_name" type="VARCHAR(255)">
                <!-- Oracle: VARCHAR2(255) -->
                <constraints nullable="false"/>
            </column>
            <column name="email" type="VARCHAR(255)">
                <!-- Oracle: VARCHAR2(255) -->
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="TIMESTAMPTZ" defaultValueComputed="NOW()">
                <!-- Oracle: TIMESTAMP WITH TIME ZONE DEFAULT SYSTIMESTAMP -->
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="TIMESTAMPTZ" defaultValueComputed="NOW()">
                <!-- Oracle: TIMESTAMP WITH TIME ZONE DEFAULT SYSTIMESTAMP -->
                <constraints nullable="false"/>
            </column>
        </createTable>

        <createIndex indexName="idx_persons_email"
                     tableName="persons"
                     unique="true">
            <column name="email"/>
        </createIndex>

        <rollback>
            <dropIndex indexName="idx_persons_email" tableName="persons"/>
            <dropTable tableName="persons"/>
        </rollback>
    </changeSet>

</databaseChangeLog>
